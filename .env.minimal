# CodeVerify — Minimal local development config
# Works out of the box with: docker compose up -d postgres redis
#
# For AI analysis features, copy .env.example instead and add your API keys.

DATABASE_URL=postgresql://codeverify:codeverify@localhost:5432/codeverify
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=local-dev-secret-not-for-production
JWT_SECRET=local-dev-jwt-not-for-production
