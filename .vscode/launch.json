{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["codeverify_api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Celery Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "codeverify_worker.main", "worker", "--loglevel=info"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
